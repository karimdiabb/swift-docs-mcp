{
  "name": "swift-docs-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Local, read-only MCP server for Apple developer documentation",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "RUN_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "research:discovery": "node research/discovery.ts",
    "research:pages": "node research/pages.ts",
    "research:edges": "node research/edges.ts",
    "index:build": "node src/index.ts index build",
    "index:refresh": "node src/index.ts index refresh",
    "index:enrich": "node src/index.ts index enrich",
    "index:status": "node src/index.ts index status",
    "cache:clear": "node src/index.ts cache clear",
    "doc": "node src/index.ts doc"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
