{
  "name": "swift-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial local, read-only MCP server for Apple developer documentation and swift.org docs",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "start": "node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "RUN_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "index:build": "node src/index.ts index build",
    "index:refresh": "node src/index.ts index refresh",
    "index:enrich": "node src/index.ts index enrich",
    "index:status": "node src/index.ts index status",
    "cache:clear": "node src/index.ts cache clear",
    "doc": "node src/index.ts doc"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "swift-docs-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/karimdiabb/swift-docs-mcp.git"
  },
  "license": "MIT"
}
